# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# Supabase > Project Settings > API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (starts with sb_secret_). Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Supabase > Connect > Session pooler (URI). Only used to run migrations from this machine.
DATABASE_URL=

# Anthropic Console > API Keys
ANTHROPIC_API_KEY=

# Optional tuning
# AI_MODEL=claude-opus-5-5
# AI_SAMPLES=3

# Public demo protection: AI spend limits in US dollars.
# AI_DAILY_BUDGET_USD=10
# AI_TOTAL_BUDGET_USD=60
# AI_CLIENT_HOURLY_USD=6
